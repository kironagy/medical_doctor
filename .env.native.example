APP_NAME="Medical Plus"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_IN_LOCAL_ENV_FILE
APP_DEBUG=false
APP_URL=http://127.0.0.1
ASSET_URL=""

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/data/data/com.medicalplus.app/app_storage/persisted_data/database/medical_plus.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

NATIVEPHP_APP_ID=com.medicalplus.app
NATIVEPHP_APP_VERSION=1.0.52
NATIVEPHP_APP_VERSION_CODE=52
NATIVEPHP_START_URL=/login
NATIVEPHP_ANDROID_COLOR_PRIMARY=#04ABA6
NATIVEPHP_ANDROID_COLOR_PRIMARY_NIGHT=#FFFFFF
