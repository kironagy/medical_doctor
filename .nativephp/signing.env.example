# Android APK signing credentials
# Copy this file to signing.env and fill in your actual values.
# signing.env is git-ignored — never commit it.

# Absolute path to your keystore (.jks or .keystore) file
SIGNING_KEYSTORE_PATH=/absolute/path/to/your/keystore.jks

# Key alias inside the keystore
SIGNING_KEY_ALIAS=your_key_alias

# Keystore password (required if your keystore is password-protected)
SIGNING_KEY_STORE_PASSWORD=your_keystore_password

# Key password (required if your key entry has a separate password)
SIGNING_KEY_PASSWORD=your_key_password
