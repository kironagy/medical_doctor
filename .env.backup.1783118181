APP_NAME=MedicalPlus
APP_ENV=production
APP_KEY=base64:y7T5JDhrHDT84FcZ0ZTkF7KI4bm6XUR1qahb78OIQc4=
APP_DEBUG=false
APP_URL=http://localhost
MOBILE_API_URL=https://prof-hosam-fekry.online/api/v1/mobile

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No local database - all data comes from production API
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=medical_plus
DB_USERNAME=kdev
DB_PASSWORD=kdev

# File-based session (no database needed)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sync queue (no database needed)
QUEUE_CONNECTION=sync

# File-based cache (no database needed)
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_START_URL=/login
NATIVEPHP_ANDROID_SDK_LOCATION=/Users/kiro/Library/Android/sdk
